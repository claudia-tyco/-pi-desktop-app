{
  "name": "pi-management-system",
  "version": "1.0.0",
  "main": "./src/main.js",
  "scripts": {
    "build": "tsc || echo 'TypeScript编译跳过（非TS项目）'",  // 编译失败也不中断
    "dist:win": "npm run build && electron-builder --win --x64",
    "start": "electron ."
  },
  "build": {
    "appId": "com.pi.management",
    "productName": "PI-Management-System",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "^25.0.0",
    "electron-builder": "^24.6.4",
    "typescript": "^5.1.6"
  },
  "dependencies": {
    "sqlite3": "^5.1.6"
  }
}
